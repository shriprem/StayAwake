    CONTROL         "Unassigned Key #&5",IDC_KEY_UNASSIGNED_5,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,105,90,10
    CONTROL         "Unassigned Key #&6",IDC_KEY_UNASSIGNED_6,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,120,90,10
    CONTROL         "Unassigned Key #&7",IDC_KEY_UNASSIGNED_7,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,135,90,10
    CONTROL         "Unassigned Key #&8",IDC_KEY_UNASSIGNED_8,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,150,90,10
    CONTROL         "Unassigned Key #&9",IDC_KEY_UNASSIGNED_9,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,165,90,10
    CONTROL         "Unassigned Key #1&0",IDC_KEY_UNASSIGNED_10,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,180,90,10
    PUSHBUTTON      "Select &All",IDC_KEY_SELECT_ALL_BTN,115,15,50,14
    PUSHBUTTON      "Select &None",IDC_KEY_SELECT_NONE_BTN,115,35,50,14
    DEFPUSHBUTTON   "A&pply",IDOK,115,55,50,14
