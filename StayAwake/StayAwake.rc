IDD_ABOUTBOX DIALOGEX 0, 0, 210, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About StayAwake"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,35,14,21,20
    CTEXT           "StayAwake",IDC_ABOUT_NAME,55,14,100,8,SS_NOPREFIX
    CTEXT           "Version 1.0.0.1",IDC_ABOUT_VERSION,55,26,100,8
    CTEXT           "Last code update:",IDC_ABOUT_BUILD_TIME,10,38,190,8
    CTEXT           "Copyright (C) Shridhar Kumar, 2026",IDC_ABOUT_ATTRIBUTION,10,54,190,8
    CONTROL         "<a>GitHub Link</a>",IDC_ABOUT_PROD_URL,"SysLink",WS_TABSTOP,86,70,37,8
    CTEXT           "If you like StayAwake, please star this repo in GitHub.",IDC_ABOUT_PROD_REQ,10,82,190,8
    DEFPUSHBUTTON   "OK",IDOK,80,100,50,14,WS_GROUP
END

IDD_STAYAWAKE_DIALOG DIALOGEX 0, 0, 205, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
