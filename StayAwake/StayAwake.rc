    CONTROL         "&Volume Down && Up",IDC_KEY_VOLUME_UP_DOWN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,30,90,10
    CONTROL         "Unassigned Key #&1",IDC_KEY_UNASSIGNED_1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,45,90,10
    CONTROL         "Unassigned Key #&2",IDC_KEY_UNASSIGNED_2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,60,90,10
    CONTROL         "Unassigned Key #&3",IDC_KEY_UNASSIGNED_3,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,75,90,10
