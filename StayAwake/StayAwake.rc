IDD_ABOUTBOX DIALOGEX 0, 0, 191, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About StayAwake"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,12,14,21,20
    CTEXT           "StayAwake",IDC_ABOUT_NAME,39,14,111,8,SS_NOPREFIX
    CTEXT           "Copyright (C) Shridhar Kumar, 2026",IDC_ABOUT_ATTRIBUTION,18,54,154,8
    DEFPUSHBUTTON   "OK",IDOK,70,81,50,14,WS_GROUP
    CTEXT           "Version 1.0.0.1",IDC_ABOUT_VERSION,39,26,111,8
    CTEXT           "Last code update:",IDC_ABOUT_BUILD_TIME,19,38,151,8
    CONTROL         "<a>GitHub Link</a>",IDC_ABOUT_PROD_URL,"SysLink",WS_TABSTOP,77,66,37,8
END

IDD_STAYAWAKE_DIALOG DIALOGEX 0, 0, 205, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "StayAwake"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Select multiple &Key Codes for random simulation",IDC_STAYAWAKE_KEYS_ROSTER_BTN,13,12,179,14
    RTEXT           "&Minimum Awake Seconds:",IDC_STATIC,1,35,100,8
    EDITTEXT        IDC_STAYAWAKE_INTERVAL_MIN,102,32,27,13,ES_NUMBER
    RTEXT           "Ma&ximum Awake Seconds:",IDC_STATIC,1,55,100,8
    EDITTEXT        IDC_STAYAWAKE_INTERVAL_MAX,102,52,27,13,ES_NUMBER
    PUSHBUTTON      "Set &Timer",IDC_STAYAWAKE_SET_INTERVAL_BTN,132,32,60,34
    RTEXT           "",IDC_STAYAWAKE_LAST_EVENT,1,74,143,8
    RTEXT           "",IDC_STAYAWAKE_LAST_KEYCODE,1,82,143,8
    RTEXT           "",IDC_STAYAWAKE_NEXT_EVENT,1,93,143,8
    PUSHBUTTON      "&Pause",IDC_STAYAWAKE_PAUSE_RESUME_BTN,16,110,50,14
    PUSHBUTTON      "Minimi&ze",IDC_MINIMIZE,74,110,50,14
    PUSHBUTTON      "&Exit",IDC_EXIT,132,110,50,14
    CONTROL         "&Launch application in minimized state",IDC_START_MINIMIZED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,38,128,128,10
    PUSHBUTTON      "...",IDC_ABOUT_BUTTON,188,126,15,13,BS_BITMAP
END

IDD_SELECT_KEYCODES_DIALOG DIALOGEX 0, 0, 180, 205
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
